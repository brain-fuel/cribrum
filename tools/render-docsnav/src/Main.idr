||| `render-docsnav` — close plan §T6.
|||
||| Drives the Cribrum pipeline end-to-end for the docs-nav demo:
|||
|||   README.dj
|||     -> parseDoc  (Cribrum.Djot.Parser)
|||     -> elaborate (Cribrum.Elaborate, strict)
|||     -> addHeadingIds (Cribrum.Pipeline.Anchor)
|||     -> renderHtml (Cribrum.Render.Html) over the unwrapped body
|||     -> harvestHeadings -> Generated.idr (TOC items, h2+h3 only)
|||     -> page chrome wrap -> examples/teaweb/docsnav/index.html
|||
||| Replaces the previously hand-authored static HTML + hand-coded TOC.
||| Anchors are slugified from the heading text; in-page navigation now
||| works without manual sync because the TOC links and the heading ids
||| come from the same `slugify` function.
module Main

import System
import System.File
import Data.List
import Data.String
import Cribrum.Node
import Cribrum.Djot.Surface
import Cribrum.Djot.Parser
import Cribrum.Html.Valid
import Cribrum.Elaborate
import Cribrum.Render.Html
import Cribrum.Pipeline.Anchor

%default total

--------------------------------------------------------------------------------
-- Pipeline.
--------------------------------------------------------------------------------

||| Strip the outer `<main>` wrapper inserted by `elaborateDoc` so the body
||| can compose into the docsnav page chrome (which has its own
||| `<main class="docs-content">`). For anything else, render as-is.
unwrapMain : HExpr -> List HExpr
unwrapMain (Element "main" _ cs) = cs
unwrapMain h                     = [h]

renderBody : HExpr -> String
renderBody h = concatMap renderHtml (unwrapMain h)

||| End-to-end: parse + elaborate + anchor + render-body, plus harvest
||| the heading rows for the TOC.
processSource :  String
              -> Either String (String, List (Nat, String, String))
processSource src = case parseDoc src of
  Left e  => Left ("parse failed: " ++ show e)
  Right d => case elaborate d of
    Left e             => Left ("elaborate failed: " ++ show e)
    Right (h ** (_, _)) =>
      let h2  = addHeadingIds h
          bod = renderBody h2
          hs  = harvestHeadings h2
       in Right (bod, hs)

--------------------------------------------------------------------------------
-- TOC filtering: keep h2 + h3 only, map level so h2 -> 1, h3 -> 2.
-- The page's `<h1>` is the document title, displayed separately above the
-- TOC, so it doesn't appear in the side-pane list.
--------------------------------------------------------------------------------

tocLevel : Nat -> Maybe Nat
tocLevel 2 = Just 1
tocLevel 3 = Just 2
tocLevel _ = Nothing

tocRows : List (Nat, String, String) -> List (Nat, String, String)
tocRows = mapMaybe go
  where
    go : (Nat, String, String) -> Maybe (Nat, String, String)
    go (lvl, anchor, title) = case tocLevel lvl of
      Just l  => Just (l, anchor, title)
      Nothing => Nothing

--------------------------------------------------------------------------------
-- Generated.idr emitter.
--------------------------------------------------------------------------------

escapeIdrisString : String -> String
escapeIdrisString = pack . concatMap esc . unpack
  where
    esc : Char -> List Char
    esc '\\' = ['\\', '\\']
    esc '"'  = ['\\', '"']
    esc c    = [c]

linePrefix : Bool -> String
linePrefix True  = "  [ "
linePrefix False = "  , "

tocItemLine : Bool -> (Nat, String, String) -> String
tocItemLine isFirst (lvl, anchor, title) =
  linePrefix isFirst
    ++ "MkTocItem \""
    ++ escapeIdrisString anchor
    ++ "\" \""
    ++ escapeIdrisString title
    ++ "\" "
    ++ show lvl
    ++ "\n"

renderTocList : List (Nat, String, String) -> String
renderTocList []        = "  []\n"
renderTocList (r :: rs) =
  tocItemLine True r
    ++ concatMap (tocItemLine False) rs
    ++ "  ]\n"

emitGenerated : List (Nat, String, String) -> String
emitGenerated items =
  "||| AUTO-GENERATED by tools/render-docsnav — do not edit by hand.\n"
    ++ "|||\n"
    ++ "||| Source: README.dj headings (h2 -> TocItem level 1, h3 -> level 2).\n"
    ++ "||| Anchors are slugified from heading text by `Cribrum.Pipeline.Anchor`,\n"
    ++ "||| so they match the `id` attributes the same pipeline writes onto the\n"
    ++ "||| corresponding `<h2>`/`<h3>` elements in `index.html`.\n"
    ++ "module Generated\n\n"
    ++ "import TocData\n\n"
    ++ "%default total\n\n"
    ++ "public export\n"
    ++ "genTocItems : List TocItem\n"
    ++ "genTocItems =\n"
    ++ renderTocList items

--------------------------------------------------------------------------------
-- Page chrome — copied verbatim from the previous hand-authored
-- `index.html`, minus the static prose (now driven by README.dj) and the
-- mount-point `<main>` (replaced with `<div>` to avoid two `<main>`
-- elements in the final document, which would violate `unique-main`).
--------------------------------------------------------------------------------

chromeHeadAndOpen : String
chromeHeadAndOpen = """

chromeClose : String
chromeClose = """
      </main>
    </div>
    <script src="build/exec/docsnav"></script>
  </body>
</html>
"""

wrapDocsnavPage : String -> String
wrapDocsnavPage body = chromeHeadAndOpen ++ body ++ "\n" ++ chromeClose

--------------------------------------------------------------------------------
-- IO plumbing.
--------------------------------------------------------------------------------

covering
readOrFail : String -> IO String
readOrFail path = do
  Right s <- readFile path
    | Left err => do
        putStrLn ("read error (" ++ path ++ "): " ++ show err)
        exitFailure
  pure s

covering
writeOrFail : String -> String -> IO ()
writeOrFail path contents = do
  Right () <- writeFile path contents
    | Left err => do
        putStrLn ("write error (" ++ path ++ "): " ++ show err)
        exitFailure
  pure ()

covering
main : IO ()
main = do
  args <- getArgs
  case args of
    [_, dj, html, gen] => do
      src <- readOrFail dj
      case processSource src of
        Left err =>
          do putStrLn err
             exitFailure
        Right (body, headings) => do
          let toc = tocRows headings
          writeOrFail html (wrapDocsnavPage body)
          writeOrFail gen  (emitGenerated toc)
          putStrLn $ "wrote " ++ html ++ " (" ++ show (length body)
                      ++ " body bytes, " ++ show (length toc)
                      ++ " TOC entries)"
          putStrLn $ "wrote " ++ gen
    _ => do
      putStrLn "usage: render-docsnav <README.dj> <index.html> <Generated.idr>"
      exitFailure

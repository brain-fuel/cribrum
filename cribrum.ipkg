package cribrum
version = 0.1.0
authors = "Matthew Laine"
brief   = "Single-IR HTML elaboration: Djot prose -> proof-carrying semantic accessible HExpr."

sourcedir = "src"
depends   = base
          , contrib

modules = Cribrum.Node
        , Cribrum.Djot.Surface
        , Cribrum.Djot.Parser
        , Cribrum.Html.Category
        , Cribrum.Html.Model.Types
        , Cribrum.Html.Model.Generated
        , Cribrum.Html.Model
        , Cribrum.Html.Model.Invariants
        , Cribrum.Html.Valid
        , Cribrum.Elaborate
        , Cribrum.Render.Html
        , Cribrum.Render.Dom
        , Cribrum.AA.Catalog
        , Cribrum.AA.Pass
        , Cribrum.AA.Promote
        , Cribrum.AA.Typed
